# Copy file này thành .env và điền vào các khóa API

# Django
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True

# Database (để trống để dùng SQLite)
# DB_NAME=aimusic
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Hugging Face Token (dùng cho mô hình nhạc ACE-Step)
HF_TOKEN=hf_your_token_here

# ── SUNO AI INTEGRATION (Đạt chất lượng âm thanh và giọng hát tiếng Việt chuẩn Suno 100%) ──
# Điền 1 trong 2 thông tin dưới đây để kích hoạt Suno Engine:
# Cách 1: Suno Cookie (từ suno.com cá nhân) hoặc Bearer Token
SUNO_COOKIE=
# Cách 2: Suno Third-Party API Key (SunoAPI / GoAPI / AIMLAPI / Kie.ai)
SUNO_API_KEY=
SUNO_API_URL=https://api.sunoapi.org/api/v1/suno/create

# ── TRUE AI BRAIN (Sáng tác lời & Chatbot thực thụ) ─────────────────────────
# Chọn 1 trong 2 hoặc điền cả 2 (hệ thống sẽ tự động chọn):
# 1. Google Gemini (KHUYÊN DÙNG: Miễn phí, cực nhanh, viết lời tiếng Việt rất hay)
# Lấy API Key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. OpenAI (GPT-4o-mini)
# Lấy API Key tại: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Tùy chọn provider ưu tiên: 'auto' | 'gemini' | 'openai'
LLM_PROVIDER=auto
